generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Author {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  genres    String    @default("[]") // JSON string[]
  bio       String // paragraphs separated by a blank line
  journey   String?
  photo     String?
  website   String?
  demo      Boolean   @default(false)
  sortOrder Int       @default(0)
  books     Book[]
  features  Feature[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Genre {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  displayOrder Int     @default(0)
  parentId     String?
  parent       Genre?  @relation("GenreTree", fields: [parentId], references: [id])
  children     Genre[] @relation("GenreTree")
}

model Book {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  subtitle      String?
  series        String? // series position line
  coAuthors     String? // extra byline names, e.g. "D.K. Holmberg" (no author page)
  seriesList    String? // JSON { title, items[] }
  authorId      String
  author        Author    @relation(fields: [authorId], references: [id])
  genre         String // primary category
  tags          String    @default("[]") // JSON string[]
  hook          String
  description   String    @default("[]") // JSON string[] (paragraphs)
  cover         String
  realCover     Boolean   @default(false)
  coverPending  Boolean   @default(false)
  tone          String    @default("ink") // oxblood | ink | umber
  published     String?
  publisher     String?
  language      String?
  format        String?
  externalUrl   String?
  externalLabel String?
  recognition   String? // JSON { source, items[] }
  coverQuote    String? // JSON { text, attribution }
  addedAt       String
  demo          Boolean   @default(false)
  featured      Boolean   @default(false) // homepage "On Our Reading Radar"
  visible       Boolean   @default(true)
  sortOrder     Int       @default(0)
  features      Feature[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([visible, sortOrder])
  @@index([authorId])
}

model Feature {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  imageUrl      String?
  authorId      String?
  author        Author?   @relation(fields: [authorId], references: [id])
  bookId        String?
  book          Book?     @relation(fields: [bookId], references: [id])
  status        String    @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BookSubmission {
  id                 String   @id @default(cuid())
  authorName         String
  email              String
  authorWebsite      String?
  profileLink        String?
  country            String?
  authorBio          String
  bookTitle          String
  subtitle           String?
  primaryGenre       String
  secondaryGenre     String?
  description        String
  publicationDate    String?
  publisher          String?
  isbn               String?
  language           String?
  format             String?
  coverPath          String?
  purchaseLink       String?
  officialBookPage   String?
  whyInclude         String?
  isPublished        Boolean
  expectedPubDate    String?
  featureInterest    Boolean  @default(false)
  rightsConsent      Boolean
  promotionalConsent Boolean  @default(false)
  status             String   @default("RECEIVED") // RECEIVED | UNDER_REVIEW | INFO_REQUESTED | APPROVED | DECLINED | PUBLISHED
  internalNotes      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Affiliate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tagline     String?
  description String
  logo        String?
  banner      String?
  link        String // Facebook or website
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
}

model AffiliateApplication {
  id            String   @id @default(cuid())
  communityName String
  contactName   String
  email         String
  link          String
  description   String
  logoPath      String? // private storage/uploads/...
  status        String   @default("RECEIVED") // RECEIVED | APPROVED | DECLINED
  createdAt     DateTime @default(now())
}
